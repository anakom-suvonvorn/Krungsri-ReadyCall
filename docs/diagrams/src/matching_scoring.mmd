%% HANDWRITTEN. Checked against ARCHITECTURE.md S8 + D22 + D23 + D93 + B12 + B13
%% + the FitBreakdown model
flowchart TB
    PAIR["for EVERY (waiting call, free agent) pair"]:::in

    PAIR --> HARD{"<b>HARD FILTERS</b> - pass or excluded"}:::gate
    HARD -- fail --> OUT["excluded entirely.<br/>Not a low score - <b>not a candidate</b>."]:::bad
    HARD -- pass --> FIT

    subgraph FIT["<b>FIT</b> - how good is this agent FOR THIS CALL"]
        direction TB
        F1["skill_match - do they have the required skill,<br/>and how proficient"]:::f
        F2["continuity - did they handle this customer before"]:::f
        F3["historical_fit - how they do on this intent"]:::f
        F4["load_penalty - subtract for current load"]:::f
    end

    FIT --> URG
    subgraph URG["<b>URGENCY</b> - how badly does THIS CALL need someone"]
        direction TB
        U1["wait_pressure - how long they have waited"]:::u
        U2["sla_risk - about to breach"]:::u
        U3["customer_priority - segment, vulnerability"]:::u
        U4["situational - at a crash scene, a medical emergency"]:::u
    end

    URG --> SCORE["score = fit x urgency multiplier"]:::score
    SCORE --> SOLVE["<b>Hungarian solver</b> over the whole matrix"]:::solve
    SOLVE --> DEC[("<b>MatchingDecision</b> - persisted<br/>every candidate, every sub-score, the weights<br/>version, the solver, and how long it took")]:::store

    WHY1["<b>why urgency MULTIPLIES rather than adds.</b><br/>Pure best-fit starves people: a caller nobody is<br/>a great match for waits forever while better-matched<br/>callers overtake them. The multiplier means waiting<br/>itself eventually wins - wait_pressure climbs toward<br/>the 3.0 ceiling and dominates the matrix.<br/><br/><b>Past MAX_WAIT_BEFORE_ANY_AGENT_S that stops being<br/>a tendency and becomes a guarantee (D93):</b> a pre-pass<br/>runs BEFORE the solver and hands the caller the<br/>lowest-fit QUALIFIED free agent, longest wait first.<br/>Lowest, not best - the specialist stays free for<br/>whoever actually needs them.<br/><br/>Two bugs lived here, both invisible inside one queue.<br/>B12: waiting_s was frozen at admit, so wait_pressure<br/>was pinned at 0. B13: the ceiling sat in _guard, which<br/>only runs for a call the solver ALREADY chose."]:::note

    WHY2["<b>why global rather than greedy - MEASURED (D49).</b><br/>scripts/run_matching.py --compare scores both on the<br/>same matrix. Across seven seeds greedy left between<br/><b>0.0% and 8.2%</b> on the table. So the honest claim is not<br/>'greedy is bad' - it is that greedy is usually fine and<br/>occasionally much worse, and it is worst exactly when<br/>agents are scarce relative to skill diversity, which is<br/>when routing matters most."]:::note

    WHY3["<b>why persist every candidate (D18).</b> 'Why did I get<br/>this call?' has to be answerable. A matching decision<br/>you cannot explain is one nobody will trust enough<br/>to leave switched on."]:::note

