    classDef f fill:#eef4ff,stroke:#5b8def,color:#0b2545
    classDef u fill:#fff4e6,stroke:#e8a33d,color:#4a2f00
    classDef score fill:#e9f7ef,stroke:#2f9e5f,color:#08361d
    classDef solve fill:#1f6feb,stroke:#0b3d91,color:#fff
    classDef store fill:#e9f7ef,stroke:#2f9e5f,color:#08361d
    classDef note fill:#fffbe6,stroke:#d4a72c,color:#4a3800
