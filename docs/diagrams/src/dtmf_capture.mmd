    classDef gate2 fill:#1f6feb,stroke:#0b3d91,color:#fff
    classDef ok fill:#e9f7ef,stroke:#2f9e5f,color:#08361d
    classDef opt fill:#f5f5f5,stroke:#999,color:#666,stroke-dasharray:4 3
    classDef ev fill:#eef4ff,stroke:#5b8def,color:#0b2545
    classDef store fill:#e9f7ef,stroke:#2f9e5f,color:#08361d
