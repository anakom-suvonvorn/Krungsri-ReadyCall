    classDef other fill:#f5f5f5,stroke:#999,color:#333
    classDef save fill:#eef4ff,stroke:#5b8def,color:#0b2545
    classDef store fill:#e9f7ef,stroke:#2f9e5f,color:#08361d
    classDef gate fill:#1f6feb,stroke:#0b3d91,color:#fff
    classDef ok fill:#e9f7ef,stroke:#2f9e5f,color:#08361d
    classDef neutral fill:#fff4e6,stroke:#e8a33d,color:#4a2f00
