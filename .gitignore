# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets & local config (keep .env.example committed)
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# Data we must never commit
data/
recordings/
*.wav
*.mp3
*.m4a
*.flac
transcripts/
mock/bank_core/generated/

# Models / caches
# NOTE: anchored to the repo root ON PURPOSE. A bare `models/` matches at ANY depth, and
# it silently swallowed `src/readycall/db/models/` — the entire ORM package — so a phase
# that looked committed had no tables in a fresh clone (`B9`). ML weights live at the root.
/models/
*.bin
*.safetensors
*.ct2/
.cache/
.hf_cache/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage*

# Node (agent desktop / customer simulator)
node_modules/
apps/**/dist/
apps/**/.vite/

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp

# Real customer speech from the Thai call-centre dataset (`D97`). Names, phone numbers
# and account details are in the transcripts, so neither the audio nor the references may
# be committed - this is a PDPA position, not tidiness (`D14`).
/tests/audio/thai_calls/
/models/
