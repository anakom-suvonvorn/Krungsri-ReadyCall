# Copy to .env and adjust. Never commit .env (it is gitignored).
# The full documented surface lives in docs/INTEGRATIONS.md section 7.

ENV=dev
DEBUG=false
LOG_FORMAT=console

# --- adapter selection (D3). P0 defaults run with no keys and no services. ---
TELEPHONY_PROVIDER=simulated
STT_ENGINE=scripted
LLM_PROVIDER=rulebased
TTS_ENGINE=null
CORE_DATA_PROVIDER=fixtures
CORE_FIXTURES_DIR=mock/bank_core/fixtures
INTAKE_STRATEGY=passive
EVENT_BUS=memory
BLOB_STORAGE=memory

# --- switch on the real things as phases land ---
# STT_ENGINE=thonburian_ct2
# STT_MODEL=biodatlab/whisper-th-medium-combined
# STT_DEVICE=cuda
# STT_COMPUTE_TYPE=int8_float16

# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=

# One adapter covers Typhoon API, OpenAI, vLLM and Ollama (D29) - just the base URL.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.opentyphoon.ai/v1
# LLM_API_KEY=

# --- behaviour (all runtime-tunable; never hardcode these) ---
INTAKE_MAX_DURATION_S=180
INTAKE_SILENCE_TIMEOUT_S=6
INTAKE_REOFFER_AFTER_S=90
ANALYSIS_DEBOUNCE_S=5
CONFIDENCE_FLOOR=0.55
LLM_TIMEOUT_S=8
BRIEF_DEADLINE_MS=1000
LIVE_CALL_TRANSCRIPTION=true

# --- matching (D22) ---
MATCHER_SOLVER=hungarian
TARGET_WAIT_S=45
MAX_WAIT_BEFORE_ANY_AGENT_S=180
DEFER_ENABLED=true
DEFER_MAX_WAIT_S=60
DEFER_MAX_HOLD_S=25
DEFER_MIN_FIT_GAP=0.25

# --- agent workstation (D32, D33) ---
AGENT_ACCEPT_MODE=manual
OFFER_TIMEOUT_S=20
ACW_TIMER_S=45
# SIP_WSS_URL=wss://asterisk.local:8089/ws
