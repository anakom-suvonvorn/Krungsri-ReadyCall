# ======================================================================================
# Copy to `.env` and edit. `.env` is gitignored; THIS file is committed, so it carries
# names and never values.
#
#   cp .env.example .env
#
# Everything here has a working default. The system runs with **no keys, no services, no
# GPU and no database** — that is `D3`, and it is what makes a demo on a strange laptop
# survivable. Uncomment a line only when you want the real thing behind it.
#
# The full documented surface is `docs/INTEGRATIONS.md` §7.
# ======================================================================================

ENV=dev
DEBUG=false
LOG_FORMAT=console

# --- adapter selection (D3). These defaults need nothing installed. --------------------
TELEPHONY_PROVIDER=simulated
STT_ENGINE=scripted
VAD_ENGINE=energy
LLM_PROVIDER=rulebased
TTS_ENGINE=null
CORE_DATA_PROVIDER=fixtures
CORE_FIXTURES_DIR=mock/bank_core/fixtures
INTAKE_STRATEGY=passive
EVENT_BUS=memory
STORAGE_BACKEND=memory
BLOB_STORAGE=memory


# ======================================================================================
# SECRETS
#
# Fill these in `.env` only. Names live here; values never do.
#
# Marked [READ] where an adapter uses it today and [SLOT] where the field exists and its
# adapter does not — a declared secret is redacted from every log line by name
# (`logging._SENSITIVE_KEYS`), so having the slot ready is what stops a live key being
# pasted somewhere with no obvious home. Setting a [SLOT] key changes nothing yet.
# ======================================================================================

# --- LLM (P4). One of these, depending on LLM_PROVIDER. -------------------------------
# ⚠️ These are [READ] now (`D119`, 2026-09-07). `build_llm` exists and both adapters are
# real, so setting LLM_PROVIDER here CHANGES WHAT THE SYSTEM DOES and will spend money.
# The SDKs live in the `llm` extra: `uv sync --extra llm` - and name every other extra you
# want in the same command, because uv sync PRUNES (`B31`).
# [READ] LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5

# [READ] One adapter covers Typhoon-hosted, OpenAI, vLLM, Ollama and LM Studio (`D119`) — the only
# difference is the base URL. Ollama needs no key at all.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.opentyphoon.ai/v1
# LLM_API_KEY=
# LLM_MODEL=typhoon-v2.1-12b-instruct

# [READ] For OpenAI itself, the base URL is theirs and the key may be under EITHER name
# (`D130`). `LLM_API_KEY` wins when both are set; `OPENAI_API_KEY` exists because that is
# the name OpenAI's own SDK and every tutorial use, and a key in `.env` under a name
# nothing reads is indistinguishable from no key at all.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# LLM_MODEL=gpt-5.4-mini

# --- the two-stage AI summary (`D131`) ------------------------------------------------
# [READ] The summary runs TWICE: a preview while the offer card is on screen, and the real
# one after Accept over the whole transcript. These three name the model for the PREVIEW
# only; leave them unset and both passes use LLM_MODEL, which is the simple configuration.
#
# A second model buys exactly one thing — speed — and `scripts/compare_llm.py` is what
# turns that into a measurement. Measured 2026-09-09 over 4 Thai intakes x 3 repeats:
#   gpt-5.4-mini  p50 0.89s   $0.00072/call     <- reaches the offer card
#   claude-sonnet-5  p50 4.40s   $0.00569/call  <- does not, and is better Thai
# LLM_FAST_PROVIDER=openai_compatible
# LLM_FAST_BASE_URL=https://api.openai.com/v1
# LLM_FAST_MODEL=gpt-5.4-mini
# LLM_PREVIEW_TIMEOUT_S=4.0

# [SLOT] `GeminiAdapter` is defined in `D29` and not built.
# GEMINI_API_KEY=

# --- speech (P3). Every model this project ships with is PUBLIC. -----------------------
# [SLOT] Only needed for a gated Hugging Face checkpoint. Nothing today needs one.
# HUGGINGFACE_TOKEN=

# The versioned prompt files the adapters render. Only change this to point at a different
# prompt SET - a new prompt is a new FILE (`D119`, `D18`), never an edit in place.
# PROMPT_DIR=prompts/th

# --- the recording, and the key that protects it (D110) --------------------------------
# `BLOB_STORAGE=memory` needs no key: the objects die with the process, so a master key
# that also dies with the process is coherent. **Any durable store REFUSES TO START
# without a master key**, because ciphertext nobody can ever read is worse than no
# recording at all.
#
# Generate one:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
#
# ⚠️ LOSE IT AND EVERY RECORDING WRITTEN UNDER IT IS GONE. That is what envelope
# encryption means, and it is also what makes `D14`'s erasure guarantee real.
# RECORDING_MASTER_KEY=
# RECORDING_ENABLED=true
# RECORDING_RETENTION_DAYS=90

# A directory. Needs no container, and what lands there is ciphertext.
# BLOB_STORAGE=localfs
# BLOB_ROOT=var/blobs

# Or MinIO / S3. Needs `uv sync --extra s3`.
# ⚠️ Port 9000 is popular. On the dev laptop something else holds it, and the symptom is
# a boto3 "protocol violation" rather than a bind failure — publish MinIO elsewhere with
# `MINIO_PORT=19000 docker compose -f infra/docker-compose.yml up -d minio` and match here.
# BLOB_STORAGE=minio
# BLOB_ENDPOINT_URL=http://127.0.0.1:9000
# BLOB_BUCKET=readycall-recordings
# BLOB_ACCESS_KEY=readycall
# BLOB_SECRET_KEY=readycall123

# --- telephony (P5). Not built; the fields are here so the key has a home. -------------
# [SLOT] ASTERISK_ARI_USERNAME=
# [SLOT] ASTERISK_ARI_PASSWORD=
# [SLOT] TWILIO_ACCOUNT_SID=
# [SLOT] TWILIO_AUTH_TOKEN=
# SIP_WSS_URL=wss://asterisk.local:8089/ws

# --- P7: a real vault replaces LocalKeyRing (D110) -------------------------------------
# [SLOT] VAULT_TOKEN=

# --- databases -------------------------------------------------------------------------
# READYCALL_DATABASE_URL=postgresql+asyncpg://readycall:readycall@127.0.0.1:5432/readycall
# CORE_DATABASE_URL=
# REDIS_URL=redis://127.0.0.1:6379/0


# ======================================================================================
# BEHAVIOUR — no secrets past this point. All runtime-tunable; never hardcode them.
# ======================================================================================

# --- speech to text (P3) ---------------------------------------------------------------
# STT_ENGINE=typhoon              # the shipped engine (`D104`); needs the `asr` extra
# STT_ENGINE=thonburian_ct2       # the fallback; STT_MODEL must be a LOCAL directory (B23)
# STT_MODEL=
# STT_DEVICE=auto                 # cuda | cpu | auto
# STT_COMPUTE_TYPE=int8_float16
# VAD_ENGINE=silero               # needs the `ml` extra; `energy` is the degradation rung

# The decode timeout is only real under `subprocess`, because that is the only mode where
# there is a process to kill (`D112`). `inline` ignores it, deliberately.
# STT_WORKER=subprocess
# STT_DECODE_TIMEOUT_S=8.0

# --- intake / IVR ---
INTAKE_MAX_DURATION_S=180
INTAKE_SILENCE_TIMEOUT_S=6
INTAKE_REOFFER_AFTER_S=90

# --- analysis (P4) ---
ANALYSIS_DEBOUNCE_S=5
CONFIDENCE_FLOOR=0.55
LLM_TIMEOUT_S=8
BRIEF_DEADLINE_MS=1000
LIVE_CALL_TRANSCRIPTION=true

# --- matching (D22). The WEIGHTS live in config/matching_weights.yaml, not here. -------
MATCHER_SOLVER=hungarian
TARGET_WAIT_S=45
MAX_WAIT_BEFORE_ANY_AGENT_S=180
DEFER_ENABLED=true
DEFER_MAX_WAIT_S=60
DEFER_MAX_HOLD_S=25
DEFER_MIN_FIT_GAP=0.25

# --- agent workstation (D32, D33) ---
AGENT_ACCEPT_MODE=manual
OFFER_TIMEOUT_S=20
ACW_TIMER_S=45

# --- the event bus's own driver (D105). Do not raise casually: it is on the transcript's
# path to the screen, where the whole budget is 1.5 s. `0` disables it entirely.
BUS_DRAIN_INTERVAL_S=0.05
